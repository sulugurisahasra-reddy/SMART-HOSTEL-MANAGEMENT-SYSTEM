          (student_id, visitor_name, visitor_phone, relationship, purpose, entry_time, exit_time)
         VALUES ($1, $2, $3, $4, $5, $6, $7)`,
        [studentIds[studentIndex], visitorName, visitorPhone, relationship, purpose, entryTime, exitTime]
      );
    }

    const summary = await verify(
      client,
      studentIds,
      hostelId,
      [...staff.map(({ username }) => username), ...students.map(({ username }) => username)]
    );
    await client.query("COMMIT");

    console.log("SmartStay presentation dataset committed successfully.");
    console.log(JSON.stringify({ staff: staff.map(({ username, role, label }) => ({ username, role, label })), ...summary }, null, 2));
  } catch (error) {
    await client.query("ROLLBACK");
    console.error("Demo seed failed; transaction rolled back and no partial dataset was committed.");
    console.error(error.stack || error.message);
    process.exitCode = 1;
  } finally {
    client.release();
    await pool.end();
  }
}

seedDemoData();
