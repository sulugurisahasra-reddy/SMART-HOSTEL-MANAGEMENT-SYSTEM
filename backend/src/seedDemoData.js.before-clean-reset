function dateForAttendance(offset) {
  const date = new Date(Date.UTC(2026, 9, 4 - offset));
  return date.toISOString().slice(0, 10);
}

function attendanceStatus(studentIndex, dayOffset) {
  if ((studentIndex * 3 + dayOffset) % 19 === 0) return "leave";
  if ((studentIndex * 5 + dayOffset) % 11 === 0) return "absent";
  if ((studentIndex + dayOffset) % 7 === 0) return "late";
  return "present";
}

async function upsertUser(client, { username, password, role }) {
  const passwordHash = await bcrypt.hash(password, 12);
  const result = await client.query(
    `INSERT INTO users (username, password_hash, role, is_active)
     VALUES ($1, $2, $3, TRUE)
     ON CONFLICT (username) DO UPDATE
       SET password_hash = EXCLUDED.password_hash,
           role = EXCLUDED.role,
           is_active = TRUE
     RETURNING user_id`,
    [username, passwordHash, role]
  );
  return result.rows[0].user_id;
}

async function getOrCreateHostel(client) {
  const existing = await client.query(
    `SELECT hostel_id
     FROM hostels
     WHERE hostel_name = $1
     ORDER BY hostel_id
     LIMIT 1
     FOR UPDATE`,
    [DEMO_HOSTEL.hostelName]
  );

  if (existing.rows.length) {
    const hostelId = existing.rows[0].hostel_id;
    await client.query(
      `UPDATE hostels
       SET hostel_type = $1, address = $2, total_floors = $3
       WHERE hostel_id = $4`,
      [DEMO_HOSTEL.hostelType, DEMO_HOSTEL.address, DEMO_HOSTEL.totalFloors, hostelId]
    );
    return hostelId;
  }

  const created = await client.query(
    `INSERT INTO hostels (hostel_name, hostel_type, address, total_floors)
     VALUES ($1, $2, $3, $4)
     RETURNING hostel_id`,
    [DEMO_HOSTEL.hostelName, DEMO_HOSTEL.hostelType, DEMO_HOSTEL.address, DEMO_HOSTEL.totalFloors]
  );
  return created.rows[0].hostel_id;
}

async function verify(client, studentIds, hostelId, demoUsernames) {
  const counts = await client.query(
    `SELECT
       (SELECT COUNT(*)::INTEGER FROM users WHERE username = ANY($3::text[])) AS demo_users,
       (SELECT COUNT(*)::INTEGER FROM students WHERE student_id = ANY($1::int[])) AS demo_students,
       (SELECT COUNT(*)::INTEGER FROM rooms WHERE hostel_id = $2) AS demo_rooms,
       (SELECT COUNT(*)::INTEGER FROM allocations WHERE student_id = ANY($1::int[])) AS allocations,
       (SELECT COUNT(*)::INTEGER FROM allocations WHERE student_id = ANY($1::int[]) AND status = 'active') AS active_allocations,
       (SELECT COUNT(*)::INTEGER FROM fees WHERE student_id = ANY($1::int[])) AS fees,
       (SELECT COUNT(*)::INTEGER FROM complaints WHERE student_id = ANY($1::int[])) AS complaints,
       (SELECT COUNT(*)::INTEGER FROM attendance WHERE student_id = ANY($1::int[])) AS attendance,
       (SELECT COUNT(*)::INTEGER FROM visitors WHERE student_id = ANY($1::int[])) AS visitors,
       (SELECT COUNT(*)::INTEGER FROM visitors WHERE student_id = ANY($1::int[]) AND exit_time IS NULL) AS active_visitors`,
    [studentIds, hostelId, demoUsernames]
  );

  const integrity = await client.query(
    `SELECT problem, COUNT(*)::INTEGER AS count
     FROM (
       SELECT 'student_without_user' AS problem
       FROM students s LEFT JOIN users u ON u.user_id = s.user_id
       WHERE s.student_id = ANY($1::int[]) AND u.user_id IS NULL
       UNION ALL
       SELECT 'allocation_without_student_or_room'
       FROM allocations a
       LEFT JOIN students s ON s.student_id = a.student_id
       LEFT JOIN rooms r ON r.room_id = a.room_id
       WHERE a.student_id = ANY($1::int[]) AND (s.student_id IS NULL OR r.room_id IS NULL)
       UNION ALL
       SELECT 'fee_without_student'
       FROM fees f LEFT JOIN students s ON s.student_id = f.student_id
       WHERE f.student_id = ANY($1::int[]) AND s.student_id IS NULL
       UNION ALL
       SELECT 'complaint_without_student'
       FROM complaints c LEFT JOIN students s ON s.student_id = c.student_id
       WHERE c.student_id = ANY($1::int[]) AND s.student_id IS NULL
       UNION ALL
       SELECT 'attendance_without_student'
       FROM attendance a LEFT JOIN students s ON s.student_id = a.student_id
       WHERE a.student_id = ANY($1::int[]) AND s.student_id IS NULL
       UNION ALL
       SELECT 'visitor_without_student'
       FROM visitors v LEFT JOIN students s ON s.student_id = v.student_id
       WHERE v.student_id = ANY($1::int[]) AND s.student_id IS NULL
       UNION ALL
       SELECT 'room_occupancy_mismatch'
       FROM rooms r
       LEFT JOIN (
         SELECT room_id, COUNT(*)::INTEGER AS active_count
         FROM allocations
         WHERE status = 'active'
         GROUP BY room_id
       ) a ON a.room_id = r.room_id
       WHERE r.hostel_id = $2 AND r.current_occupancy <> COALESCE(a.active_count, 0)
     ) problems
     GROUP BY problem
     ORDER BY problem`,
    [studentIds, hostelId]
  );

  const expected = {
    demo_users: 18,
    demo_students: 16,
    demo_rooms: 6,
    allocations: 17,
    active_allocations: 12,
    fees: 32,
    complaints: 16,
    attendance: 224,
    visitors: 16,
    active_visitors: 6,
  };

  const actual = counts.rows[0];
  const countMismatch = Object.entries(expected).filter(([key, value]) => Number(actual[key]) !== value);
  const integrityIssues = integrity.rows.filter((row) => Number(row.count) !== 0);

  if (countMismatch.length || integrityIssues.length) {
    throw new Error(
      `Verification failed: ${JSON.stringify({ countMismatch, integrityIssues })}`
    );
  }

  return actual;
}

async function seedDemoData() {
  const client = await pool.connect();

  try {
    await client.query("BEGIN");
    await client.query("SELECT pg_advisory_xact_lock($1)", [20261004]);

    const staffIds = {};
    for (const account of staff) {
      staffIds[account.username] = await upsertUser(client, account);
    }

    const studentIdsByUsername = {};
    for (const student of students) {
      const userId = await upsertUser(client, { ...student, role: "student" });
      const result = await client.query(
        `INSERT INTO students
          (user_id, student_number, name, department, year, contact, email, preferences)
         VALUES ($1, $2, $3, $4, $5, $6, $7, $8::jsonb)
         ON CONFLICT (user_id) DO UPDATE
           SET student_number = EXCLUDED.student_number,
               name = EXCLUDED.name,
               department = EXCLUDED.department,
               year = EXCLUDED.year,
               contact = EXCLUDED.contact,
               email = EXCLUDED.email,
               preferences = EXCLUDED.preferences
         RETURNING student_id`,
        [
          userId,
          student.studentNumber,
          student.name,
          student.department,
          student.year,
          student.contact,
          student.email,
          JSON.stringify(student.preferences),
        ]
      );
      studentIdsByUsername[student.username] = result.rows[0].student_id;
    }

    const studentIds = students.map(({ username }) => studentIdsByUsername[username]);
    const hostelId = await getOrCreateHostel(client);

    for (const room of rooms) {
      await client.query(
        `INSERT INTO rooms (hostel_id, room_number, room_type, capacity)
         VALUES ($1, $2, $3, $4)
         ON CONFLICT (hostel_id, room_number) DO UPDATE
           SET room_type = EXCLUDED.room_type,
               capacity = EXCLUDED.capacity`,
        [hostelId, room.roomNumber, room.roomType, room.capacity]
      );
    }

    const nonDemoOccupants = await client.query(
      `SELECT COUNT(*)::INTEGER AS count
       FROM allocations a
       JOIN rooms r ON r.room_id = a.room_id
       WHERE r.hostel_id = $1
         AND a.status = 'active'
         AND NOT (a.student_id = ANY($2::int[]))`,
      [hostelId, studentIds]
    );

    if (nonDemoOccupants.rows[0].count > 0) {
      throw new Error(
        "Demo Residence contains active allocations outside this fixture; refusing to overwrite room occupancy."
      );
